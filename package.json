{
  "name": "seamnex",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "Seamnex — self-hosted FOSS domain platform: portal, operator console and control plane",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 <25",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "turbo run dev",
    "dev:portal": "pnpm --filter @seamnex/portal dev",
    "dev:console": "pnpm --filter @seamnex/console dev",
    "dev:api": "pnpm --filter @seamnex/api dev",
    "dev:stack": "node scripts/compose.mjs up -d",
    "kc:admin": "node scripts/kc-admin.mjs",
    "kc:check": "node scripts/kc-admin.mjs --check",
    "dev:stack:down": "node scripts/compose.mjs down",
    "dev:stack:logs": "node scripts/compose.mjs logs -f",
    "db:migrate": "pnpm --filter @seamnex/db migrate:up",
    "db:rollback": "pnpm --filter @seamnex/db migrate:down",
    "db:status": "pnpm --filter @seamnex/db migrate:status",
    "db:seed": "pnpm --filter @seamnex/db seed",
    "catalog:project": "pnpm --filter @seamnex/api catalog:project",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:route-policy": "pnpm --filter @seamnex/api exec tsx scripts/check-route-policy.ts",
    "check:no-shim": "node scripts/check-no-dev-shim.mjs",
    "check:test-tasks": "node scripts/check-test-tasks.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs --app console && node scripts/check-bundle-budget.mjs --app portal",
    "check:images": "node scripts/check-images.mjs",
    "check:s3": "node scripts/check-s3.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:brand-icon": "node scripts/check-brand-icon.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "provision:client": "pnpm --filter @seamnex/api exec tsx scripts/provision-machine-client.ts",
    "build": "turbo run build",
    "build:demo": "turbo run build:demo",
    "preview": "turbo run preview",
    "clean": "node scripts/clean.mjs",
    "clean:dry": "node scripts/clean.mjs --dry-run",
    "clean:all": "node scripts/clean.mjs --node-modules",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint --max-warnings=0 \"scripts/**/*.mjs\" \"*.mjs\"",
    "stylelint": "turbo run stylelint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:workspace": "vitest run",
    "test:integration": "pnpm --filter @seamnex/db test && pnpm --filter @seamnex/api test",
    "mocks:init": "pnpm -r --parallel mocks:init",
    "audit": "pnpm audit --registry https://registry.npmjs.org/",
    "outdated": "pnpm outdated"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@seamnex/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-security": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
