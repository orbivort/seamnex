# =============================================================================
# Seamnex — development environment
#
# Copy this file to `.env` in the repository root. You usually do not have to:
# `pnpm dev` and `pnpm dev:stack` write it for you on first run.
#
#   pnpm dev         # datastores + API + portal (5173) + console (5174)
#   pnpm dev:web     # the workspace `dev` tasks through Turbo: no Docker, no migrations
#
# One file configures everything, and no other env file is read:
#   * the API loads it via `process.loadEnvFile` (`packages/db/src/env.ts`, `loadRootEnv`)
#   * Vite reads it as `envDir` for both SPAs (`packages/config/vite/app.ts`)
#   * Docker Compose receives it through `--env-file` (`scripts/dev.mjs`, `scripts/compose.mjs`)
#   * an `.env` inside `apps/console` or `apps/portal` is never read — see those .env.example files
#
# Every value below is a *development* default: none of them may reach a production host unchanged.
# See "Production must change" at the end of this file for the ones the schema refuses to boot with.
#
# HOW TO READ A VARIABLE
#   [required]  boot fails when it is missing — the schema has no default.
#   [optional]  omit it and the schema default applies; the placeholder below IS that default.
#   Format: …   the shape the value must have (enum, URL, path, count).
#   "Dev stack" marks a variable read only by `docker/compose.dev.yml` or a shell script, not by the
#   API process; it is still needed for `pnpm dev` / `pnpm dev:stack` to work.
#
# Nothing here is deprecated: every name below is read by the API, Vite, Compose or a shell script,
# and every key the API schema reads is documented here. Two are shown commented out because an empty
# assignment is not the same as leaving them unset: an empty domain is rejected, and an empty edge
# name disables the join.
#
# SECTIONS
#    1. Runtime                          8. Edge, routes and product URLs
#    2. Database                         9. Execution adapters (Docker)
#    3. Redis                           10. Backups (S3 + age)
#    4. Secrets and keys                11. Workflows (n8n)
#    5. Authentication                  12. Observability, jobs and retention
#    6. Identity provider (Keycloak)    13. Front end (Vite)
#    7. Catalogue repository            14. Image build
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime
# -----------------------------------------------------------------------------

# [optional] What this process believes it is running as. Format: development | test | production.
# `production` is not a label: it makes the schema refuse the stub identity provider, a non-secure
# session cookie and the published S3 credentials.
NODE_ENV=development

# [optional] Which of the ten process roles this process hosts. One image, one role per process.
# Three roles serve HTTP — `api` (PORT), `auth-gateway` (8090) and `relay`
# (SEAMNEX_RELAY_PORT); the rest run background work. Compose sets this per service, so it is only
# read when a role is started by hand.
# Format: api | auth-gateway | backup-runner | broker-proxy | deploy-worker | relay | scheduler |
#         status-sampler | sync-worker | trigger-ingress
SEAMNEX_ROLE=api

# [optional] HTTP listen port for the `api` role. Format: integer 1–65535. `APP_ORIGINS` and the
# console's dev proxy both name this port, so changing it means changing those too.
PORT=8080

# [optional] Interface the `api` role binds. Format: an address. `0.0.0.0` is what lets a container
# or a proxy reach it; the DNS-rebinding guard is `VITE_DEV_ALLOWED_HOSTS`, not this.
HOST=0.0.0.0

# [optional] Log verbosity. Format: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 2. Database
# -----------------------------------------------------------------------------

# [required] PostgreSQL connection string. Format: postgres://<user>:<password>@<host>:<port>/<db>.
# Boot fails without it, and so does every `pnpm db:*` command. Keep it in step with
# `SEAMNEX_PG_HOST_PORT` and the `POSTGRES_*` values below — raising one alone aims the API at a port
# nothing listens on, or opens a database the container never created.
DATABASE_URL=postgres://seamnex:seamnex_dev_password@localhost:5432/seamnex_dev

# [optional] Connections one process may open, per pool. Format: integer 1–50. The `api` role uses
# this number; every worker role uses a quarter of it (floor two), because a worker holds a
# connection for a step rather than for a request.
DATABASE_POOL_MAX=10

# [optional] Cluster-wide connection ceiling that all nine roles together must fit inside.
# Format: integer 1–10000. Boot fails when the pools computed from `DATABASE_POOL_MAX` exceed it.
# Raising it is the deliberate act of raising Postgres `max_connections` (or adding PgBouncer);
# it is not a knob to leave at a guess.
DATABASE_CONNECTION_BUDGET=100

# [optional] [Dev stack] Host port the Postgres container publishes. Format: integer. Raise it when
# 5432 is already taken on your machine (a native PostgreSQL service, for example) and keep
# `DATABASE_URL` in step. Read by Compose only.
SEAMNEX_PG_HOST_PORT=5432

# [optional] [Dev stack] Credentials and database name the Postgres container is created with.
# Read by Compose only; they must match `DATABASE_URL` above or the API authenticates against a
# database that does not exist.
POSTGRES_USER=seamnex
POSTGRES_PASSWORD=seamnex_dev_password
POSTGRES_DB=seamnex_dev


# -----------------------------------------------------------------------------
# 3. Redis
# -----------------------------------------------------------------------------

# [required] Redis connection string, used for job queues, rate-limit buckets and the forward-auth
# decision cache. Format: redis://[user:password@]<host>:<port>[/<db>]. Boot fails without it.
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# 4. Secrets and keys
# -----------------------------------------------------------------------------

# [optional] File holding the 32-byte root key that encrypts stored credentials. Format: path.
# Contents: 32 random bytes, base64. Generated by `pnpm dev` when absent; the real key is never
# committed. Losing this file orphans every ciphertext it encrypted.
SEAMNEX_ROOT_KEY_FILE=./temp/seamnex-root-key

# [optional] Refuse a root key file that is readable by other users. Format: 1/0 (also true/false,
# yes/no, on/off). The schema default is 1; it is 0 here because a Docker Desktop bind mount
# reports mode 0777 for a file that is 0600 on disk. Use the default on a real POSIX host.
SEAMNEX_ROOT_KEY_STRICT_MODE=0


# -----------------------------------------------------------------------------
# 5. Authentication
# -----------------------------------------------------------------------------

# [optional] Which identity provider the API verifies with. Format: stub | oidc. Schema default is
# `stub`, a development affordance that authenticates nobody (the browser chooses the code); the
# schema refuses it when `NODE_ENV=production`. `oidc` is Keycloak: authorization-code + PKCE in the
# browser, the API redeems the code and verifies the ID token (ADR-BE-14).
AUTH_PROVIDER=oidc

# [optional] The realm issuer the *browser* is sent to, and the value a token's `iss` must carry.
# Format: absolute URL. Required when `AUTH_PROVIDER=oidc` — boot fails otherwise. A trailing slash
# is ignored.
AUTH_ISSUER_URL=http://localhost:8082/realms/seamnex

# [optional] How *this process* reaches that same realm when that is not the public address (a
# container resolving `keycloak:8080` while `KC_HOSTNAME` pins `iss` to `localhost:8082`).
# Format: absolute URL, or empty for "same as the issuer". Leave empty on the host: `pnpm dev:api`
# reaches the published port, and `docker/compose.dev.yml` sets the container value itself. Getting
# this wrong is the "Invalid token issuer" loop, so it is a first-class setting, not a convention.
AUTH_INTERNAL_URL=

# [optional] The relying-party client id. Format: string. One client covers every browser surface:
# the token audience is the platform, not the tab.
AUTH_CLIENT_ID=seamnex-platform-ui

# [optional] Client secret, only for a confidential client. Format: string, or empty for a public
# client authorised by PKCE alone (the shipped shape). A real secret belongs in a secret store.
AUTH_CLIENT_SECRET=

# [optional] Scopes requested at sign-in. Format: space-separated. `openid` must be present;
# `groups` is a Keycloak client scope that has to exist on the realm, not a standard OIDC scope.
AUTH_SCOPES=openid profile email groups

# [optional] Tolerance for `exp`/`iat`/`nbf`. Format: seconds, 0–300. A large window widens the
# replay window of a stolen token.
AUTH_CLOCK_SKEW_SECONDS=60

# [optional] How long discovery metadata is reused. Format: seconds, 0–86400. 0 refetches on every
# call, which is right for tests and rotation drills and wrong for production.
AUTH_DISCOVERY_CACHE_SECONDS=3600

# [optional] Floor between JWKS refetches triggered by an unknown `kid`. Format: milliseconds,
# 1000–600000. Without it, a token bearing a random key id turns every sign-in into a request
# against the identity provider.
AUTH_JWKS_MIN_REFRESH_MS=30000

# [optional] Timeout for discovery, JWKS and token calls. Format: milliseconds, 500–30000. A dead
# IdP must fail fast rather than hold a request open.
AUTH_HTTP_TIMEOUT_MS=5000

# [optional] The only callback paths an authorization code may be exchanged for. Format:
# comma-separated absolute paths. Matched exactly: an origin is not a redirect registry, and
# accepting any path under an allow-listed origin turns a provider mistake into an open redirect.
AUTH_REDIRECT_PATHS=/sign-in

# [optional] JSON directory for the stub provider. Format: path. Absent entries fall back to the
# built-in development users; an entry carrying `"mfa": true` must also carry a six-digit `mfaCode`.
AUTH_STUB_DIRECTORY=./temp/stub-identity.json

# [optional] Browser origins allowed to make cookie-authenticated unsafe requests (the CSRF check).
# Format: comma-separated absolute origins, no trailing slash. These are the two Vite dev ports and
# the API itself; a wrong value shows up as a 403 on every write, not as a broken page.
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# [optional] Session and CSRF cookie names. Format: cookie-name token (no spaces or separators).
SESSION_COOKIE_NAME=seamnex_session
CSRF_COOKIE_NAME=seamnex_csrf

# [optional] Mark cookies `Secure`. Format: 1/0 (also true/false). Development runs on plain
# localhost; the schema refuses `NODE_ENV=production` unless this is enabled.
SESSION_COOKIE_SECURE=0

# [optional] Parent domain for the session cookie, for a deployment whose portal and products share
# a registrable parent. Format: domain, no scheme. Omit it and the cookie stays host-only, which is
# the right default: the launch ticket plants the session on the product's own host, so the
# forward-auth gate never depended on a shared cookie. Leave the line commented — an empty
# assignment is not the same as omitting it, and the schema rejects an empty value.
# SESSION_COOKIE_DOMAIN=example.com

# [optional] How long a launch ticket stays redeemable. Format: seconds, 5–900. One is minted per
# open, so it only has to survive the redirect; keeping it short is what makes a leaked URL useless.
LAUNCH_TICKET_TTL_SECONDS=60

# [optional] Which peer may set `X-Forwarded-For`. Format: empty (trust nobody), 1/true (trust the
# whole chain), or an address/CIDR list. Empty is the safe default, but then `request.ip` is the
# socket address — set `1` only when the API is reachable *solely* through the edge, which is the
# case in this development stack. The sign-in rate limit keys on the client address, so a client
# that can set this header can defeat it (ADR-BE-13).
TRUST_PROXY=1


# -----------------------------------------------------------------------------
# 6. Identity provider (Keycloak)
# -----------------------------------------------------------------------------

# [optional] Keycloak Admin REST API the platform calls to register one client per instance.
# Format: absolute URL, reachable from *this* host. The admin client's secret is a file, not a value
# (see below). `pnpm kc:admin` and the dev seed read it too, which is why it is the host address here
# and `http://keycloak:8080` inside the compose stack.
SEAMNEX_KEYCLOAK_ADMIN_URL=http://localhost:8082

# [optional] Realm the platform provisions into. Format: realm name. One name for every reader: the
# API, the compose stack, the dev seed and `pnpm kc:admin`, so an override here reaches all of them.
SEAMNEX_KEYCLOAK_REALM=seamnex

# [optional] Client id used for those admin calls. Format: string.
SEAMNEX_KEYCLOAK_ADMIN_CLIENT_ID=seamnex-platform-admin

# [optional] File holding that client's secret. Format: path. Written by `pnpm kc:admin`; the
# compose stack mounts the same file at /run/seamnex/kc-admin-client-secret. Without it a deployment
# cannot register a client per instance, so the product keeps its own local credential.
SEAMNEX_KEYCLOAK_ADMIN_CLIENT_SECRET_FILE=./temp/kc-admin-client-secret

# [optional] Whether install reconciles that client automatically (ADR-BE-23). Format:
# auto | force | off. `auto` runs it when Keycloak is this platform's identity provider and the
# stack declares one, and warns instead of failing when the realm is not ready; `force` makes an
# unreachable realm or a refused credential fail `pnpm dev:stack`; `off` keeps `pnpm kc:admin` a
# manual step. It never rotates the secret in the file above, and never prints it.
SEAMNEX_KC_ADMIN_BOOTSTRAP=auto

# [optional] The IdP container, joined to each instance network when a client is registered —
# the product makes its token, JWKS and userinfo calls from its own network, not the control one.
# Format: container name, or empty to disable the step. `docker compose ps` shows the real name.
SEAMNEX_IDP_CONTAINER=seamnex-dev-keycloak-1

# [optional] The name the *product* uses for that container inside its own network, and the port it
# listens on there. Format: DNS name, and a TCP port. A container joined to a second network is not
# resolvable by its compose service name unless the name is passed as an alias, so these two have to
# match what the product was configured with (`http://keycloak:8080`).
SEAMNEX_IDP_ALIAS=keycloak
SEAMNEX_IDP_INTERNAL_PORT=8080

# [optional] How long a passing end-to-end SSO check is trusted. Format: minutes, 1–10080. Past the
# window the portal reports the sign-in path as unverified instead of as working — the failure this
# covers (the IdP losing its attachment to an instance network) happens between checks.
SEAMNEX_SSO_EVIDENCE_TTL_MINUTES=60

# [optional] How often the scheduler re-applies the IdP's attachment to each instance network.
# Format: milliseconds, 10000–3600000.
SEAMNEX_IDP_RECONCILE_INTERVAL_MS=60000

# [optional] The realm test identity the end-to-end SSO check signs in as — never a real user.
# Format: username, or empty to stop at "Keycloak accepted the authorization request". The password
# is a *file path* so it never appears in process arguments or logs.
SEAMNEX_SSO_PROBE_USERNAME=dev-user
SEAMNEX_SSO_PROBE_PASSWORD_FILE=./temp/sso-probe-password

# [optional] Identity sync cadence (deliverable 3.6): how often directory groups are materialised
# into entitlements. Format: milliseconds, 1000–3600000 (interval) and 1–5000 (batch size).
SEAMNEX_SYNC_INTERVAL_MS=300000
SEAMNEX_SYNC_BATCH_SIZE=200

# [optional] [Dev stack] Bootstrap admin and realm database credentials for the Keycloak container.
# Read by Compose only. `pnpm kc:admin` uses the admin pair to obtain its token.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak_dev_password


# -----------------------------------------------------------------------------
# 7. Catalogue repository
# -----------------------------------------------------------------------------

# [optional] Root of the working tree the catalogue loader reads: `catalog/<KEY>.json`,
# `catalog/env/<KEY>.json` and `instances/<slug>/instance.yaml`. Format: path. The platform *writes*
# `instances/` here (a deployment commits the instance definition before apply), so this must be a
# writable checkout — never this repository's own `platform/`, which holds a partial baseline only.
# Nothing clones it: the tree is prepared before start-up. If `<root>/catalog/` is absent the loader
# answers `revision: 'absent'` and the next reload treats every projection as deleted.
SEAMNEX_CATALOG_REPO_PATH=./temp/catalog-repo

# [optional] Vendored upstream trees, one directory per catalog entry (`<dir>/<entryKey>/`). Format:
# path, or empty to resolve `<SEAMNEX_CATALOG_REPO_PATH>/upstream`. When an entry has one, the resolver
# copies it instead of cloning — the only way to deploy on a host with no route to the git server.
# `platform/upstream` is the checked-in baseline; the compose stack mounts it read-only.
SEAMNEX_SOURCE_MIRROR_DIR=./platform/upstream

# [optional] Hosts a customer-supplied source URL may use (SSRF guard, 4A.2). Format: comma-
# separated host names, no scheme, no path. A URL outside this list is refused before any request.
SEAMNEX_SOURCE_ALLOWED_HOSTS=github.com,gitlab.com,codeberg.org,git.sr.ht

# [optional] Instance working trees: render sets, `instance.yaml`, scaffold drafts — no secrets.
# Format: path. The capacity guard measures this filesystem, so it must be the volume instance data
# actually lives on, not the container's overlay.
SEAMNEX_INSTANCE_DATA_DIR=./temp/instances

# [optional] Age at which a catalogue registry snapshot is reported stale (4D.6). Format: days,
# 1–3650. Reports warn, never trust silently: an out-of-date entry list looks exactly like a complete
# one, so the age is what tells an operator to reload.
SEAMNEX_REGISTRY_STALE_DAYS=30


# -----------------------------------------------------------------------------
# 8. Edge, routes and product URLs
# -----------------------------------------------------------------------------

# [optional] The one zone product routes are published under. Format: DNS zone, no scheme.
# It used to be two settings (`SEAMNEX_INSTANCE_DOMAIN` here, `SEAMNEX_INGRESS_DOMAIN` in the route
# projection), so the wizard previewed one host and the edge published another.
# `localhost` is the development value: RFC 6761 reserves the name, so `<slug>.localhost` resolves to
# loopback in every browser with no hosts-file entry. Set a real zone in production.
SEAMNEX_INGRESS_DOMAIN=localhost

# [optional] How a *browser* addresses a published product route. Format: http | https. The edge
# owns both this and the port below: production terminates TLS on 443 (`https`, empty port), the
# dev stack serves plain HTTP on 127.0.0.1:8020 (`http` + `8020`). Leaving the production default
# in a dev environment makes every launch link point at a port where nothing listens, which is why
# the development values are written out here instead of being left to a fallback.
SEAMNEX_PRODUCT_URL_SCHEME=http

# [optional] Port in that URL. Format: empty or a TCP port. Empty means "the scheme's default".
SEAMNEX_PRODUCT_URL_PORT=8020

# [optional] Traefik file-provider directory the route projection writes into. Format: path.
# The projection is its only writer; the edge reads it.
SEAMNEX_TRAEFIK_DYNAMIC_DIR=./temp/traefik/dynamic

# [optional] The edge container, attached to each instance network when a route is published, so the
# router can resolve `http://<slug>:<port>`. Format: container name, or empty to disable the join. A
# route written for an edge that is not on the network is a published 502, so empty is the safe
# default — and the right value for `pnpm dev`, which starts only the datastores. Set it when the API
# runs against the full stack; the compose services already carry their own value.
# SEAMNEX_EDGE_CONTAINER=seamnex-dev-traefik-1

# [optional] ACME contact address for a host that terminates TLS itself. Format: an email address,
# or empty. Irrelevant to the dev stack, which serves plain HTTP and has no certificate.
SEAMNEX_TRAEFIK_ACME_EMAIL=


# -----------------------------------------------------------------------------
# 8b. Sign-in relay (ADR-BE-22)
# -----------------------------------------------------------------------------

# [optional] Turning it on makes the platform the credential authority for a product it does not
# own: it creates one account per person, stores that password, rotates it monthly and signs the
# browser in through the product's own form. The product's guarantee class does not change and no
# surface may call the result single sign-on. Format: true/false.
#
# On here because this file configures the development stack, which runs the relay role. A
# deployment that must not relay keeps the platform out of that path entirely: set this to false and
# point SEAMNEX_BOOTSTRAP_URL back at the gateway. In production it additionally requires an
# authenticated, transport-protected Redis (`rediss://` or a password in `REDIS_URL`), because the
# cache holds the product's own session cookies; the schema refuses to boot otherwise.
SEAMNEX_RELAY_ENABLED=true

# [optional] Where Traefik sends `/__seamnex/session`. One value per deployment: the relay answers
# today's pass-through for every product it must not touch, so the edge keeps one hop. Format: URL
# origin, no path.
#
# Keep it in step with the two values around it: the relay answers this hop, so an enabled relay with
# this left at the gateway receives no traffic — the gateway redeems the ticket but cannot relay, and
# only a boot warning says so. `http://auth-gateway:8090` is the value a deployment without a relay
# keeps.
SEAMNEX_BOOTSTRAP_URL=http://relay:8091

# [optional] The relay role's listener. Format: TCP port. The compose service publishes none — only
# the edge on the control network talks to it. The compose health probe reads this variable, and
# SEAMNEX_BOOTSTRAP_URL above has to name the same port.
SEAMNEX_RELAY_PORT=8091

# [optional] The broker's listener, and the address the compiler writes into every node.
#
# A compiled workflow never names a product. Each node calls `/broker/{entry}/{operation}` on this
# listener, which is the only address n8n can resolve (n8n is on the control network; a product's alias
# exists only on its instance network) and the only place the product credential lives. Changing the
# port here changes both the listener and the URL the next activation compiles.
# Format: TCP port / an absolute URL reachable from the n8n container.
SEAMNEX_BROKER_PORT=8092
SEAMNEX_BROKER_URL=http://broker-proxy:8092

# [optional] A specific container to join to each instance network before the first product call. The
# product is only reachable as `http://<slug>:<port>` from that network, and a request to its host
# port reaches Apache's placeholder vhost, which answers 200.
#
# Leave it empty. A role joins *itself* — the relay for sign-in, the scheduler for provisioning — which
# is the only value that can be right for both; one fixed name made the scheduler attach the relay and
# then fail every product call as `product_unavailable`. Set it only where a sidecar makes the calls.
# Format: container name, or empty for "the caller".
# SEAMNEX_RELAY_CONTAINER=seamnex-dev-relay-1

# [optional] Catalogue entries eligible for a managed credential, comma-separated.
#
# Write the full catalogue key: `D09-01`, not the legacy `D9`. The key is `catalog_entry.key`, that
# table's primary key, so it names exactly one product: `D09-01` is OpenProject (`D09` is the OpenProject
# domain slot, `-01` is its first deployment definition), and `D07-01` is OrangeHRM.
#
# Nothing else can answer to it. The key is unique by primary key; the comparison is exact, with no
# prefix matching, so `D09-01` does not select a sibling definition such as `D09-02`; and the only
# alias is the frozen `D9 -> D09-01` row in `LEGACY_KEY_ALIASES`, which resolves to that same single
# entry rather than to a second selector. A key the catalogue does not have is ignored, because the
# comparison runs against `instance.entry_key` — a typo enables nothing and creates nothing.
#
# One value is one product. The list is the operator's consent; a product also needs a registered
# adapter (the platform's ability), and a listed entry without one is skipped as `no_adapter` and
# logged, never guessed at. Enabling the relay for a product the platform does not manage is what makes
# it the credential authority for that product.
#
# Targeting several products is the same syntax, one key each:
#   D09-01                OpenProject only (default)
#   D07-01                OrangeHRM only
#   D09-01,D07-01         both
#   D09-01, D07-01        whitespace around a key is ignored
# A duplicate is harmless: the list is compared by identity, not by count.
#
# Both keys are already excepted from FR-2.16(c) as EX-3 (`docs/mvp-platform-exceptions.md`), so this
# list needs no further requirement change. Adding a third entry does: EX-3 expires "before the relay
# is enabled for a further catalogue entry".
SEAMNEX_RELAY_ENTRY_KEYS=D09-01,D07-01

# [optional] Ceiling for one HTTP step of the sign-in relay, in milliseconds (500–60000). A slow login
# is a failed login; the launch falls back to the product's own form rather than queueing.
SEAMNEX_RELAY_HTTP_TIMEOUT_MS=8000

# [optional] How long one subject's sign-in may hold the single-flight lock, in seconds (5–120). Two
# tabs must not start two logins: the product locks an account after 20 failed attempts. It has to
# outlast the slowest sign-in, which is not one request — the driver fetches the form, submits, may
# refetch once on a stale CSRF token, then walks up to four confirmation hops. Keep it at five times
# the timeout above or more; a shorter lock expires mid-login and the next tab starts the second login
# the lock was meant to prevent.
SEAMNEX_RELAY_LOCK_SECONDS=60

# [optional] Cadence of the provision/rotate sweep, in milliseconds (10000–3600000).
#
# This is the safety net, not the latency a person sees: a completed deployment asks for its own
# accounts immediately, and a launch that finds no mapping asks for that one person, so raising this
# value does not slow down a fresh install. Offboarding is event-driven and not on this timer either.
SEAMNEX_RELAY_SWEEP_INTERVAL_MS=300000

# [optional] Ceiling on a cached product session, in seconds (60–1800). It is deliberately lower than
# any product session lifetime: a cached cookie must never outlive the entitlement that justified it.
# The product should also set OPENPROJECT_SESSION__TTL__ENABLED=true; without it the product keeps
# sessions until the server restarts and this ceiling is the only bound.
SEAMNEX_RELAY_SESSION_TTL_SECONDS=1800

# [optional] Days between automatic credential rotations. Format: 1–365.
SEAMNEX_RELAY_ROTATION_DAYS=30

# [optional] Name of the **instance-scoped** secret holding the product's admin API token, used only
# to create, re-password and lock accounts. Absent, provisioning records `admin_credential_missing`
# and retries after a quiet period — it never invents a token. Format: secret name.
SEAMNEX_RELAY_ADMIN_SECRET_NAME=product_api_token


# -----------------------------------------------------------------------------
# 9. Execution adapters (Docker)
# -----------------------------------------------------------------------------

# [optional] Whether external systems are bound. Format: real | disabled. `real` binds Docker,
# Traefik, Keycloak Admin, n8n and S3. `disabled` refuses the affected operations with a 503 that
# names the missing dependency instead of failing mid-job. No fake driver is shipped.
SEAMNEX_ADAPTERS_MODE=real

# [optional] Docker Engine endpoint. Format: unix:///path or tcp://host:port. The schema default is
# the raw socket; the stack uses the socket proxy so no process holds `/var/run/docker.sock`.
SEAMNEX_DOCKER_HOST=tcp://docker-socket-proxy:2375

# [optional] Docker API timeout for create/start/inspect calls. Format: milliseconds, 1000–600000.
SEAMNEX_DOCKER_TIMEOUT_MS=30000

# [optional] How long the `verify` stage waits for containers to run and answer HTTP. Format:
# milliseconds, 30000–1800000. This is a budget for a product that is *slow*, not for one that
# cannot start: a first install builds its database schema inside the container. Raise it locally
# for such a product — D6 (ERPNext) needs 1200000.
SEAMNEX_VERIFY_TIMEOUT_MS=300000

# [optional] Restarts tolerated during `verify` before the stage fails immediately, with the
# container's last lines in the job log. Format: integer 1–50. Three, not one: `compose up` may
# legitimately recreate a container once during apply, and three is a crash loop.
SEAMNEX_VERIFY_MAX_RESTARTS=3

# [optional] How long a container may report `unhealthy` before `verify` gives up. Format:
# milliseconds, 0–600000; 0 disables the signal for a host whose healthchecks are known to be wrong.
# Docker honours the image's own `start_period` first, so a slow first boot is not judged.
SEAMNEX_VERIFY_UNHEALTHY_GRACE_MS=120000


# -----------------------------------------------------------------------------
# 10. Backups (S3 + age)
# -----------------------------------------------------------------------------

# [optional] S3-compatible endpoint the backups land on. Format: absolute URL. The dev stack runs
# VersityGW on this port; point a real host at any S3-compatible endpoint by changing this alone.
S3_ENDPOINT=http://localhost:9000

# [optional] Bucket credentials. Format: strings. The values below are published in this repository
# and the schema refuses them when `NODE_ENV=production`, because a host that inherits them encrypts
# every backup with a key everyone can read. The bucket is created by the backup runner, not by the
# stack, so nothing here depends on it existing yet.
S3_ACCESS_KEY=seamnex_s3
S3_SECRET_KEY=seamnex_s3_dev_password

# [optional] Bucket and region. Format: bucket name (path-style addressing, so no dots-as-TLS
# problem) and an AWS region string, which S3-compatible stores still require for signing.
S3_BUCKET=seamnex-backups
S3_REGION=us-east-1

# [optional] Local scratch directory archives are written to before upload. Format: path. It needs
# room for one compressed database dump, not for the whole retention window.
SEAMNEX_BACKUP_TMP_DIR=./temp/backups

# [optional] `age` recipient that encrypts every archive before it leaves the host. Format: an age
# public key (`age1…`), or empty. Empty means "not configured", not "unencrypted": the age adapter
# refuses with a 503 that names this variable, so nothing is ever uploaded in the clear.
SEAMNEX_AGE_RECIPIENT=

# [optional] Identity (private key) file used to restore. Format: path. Keep it off the host that
# holds the backups, or the encryption protects nothing.
SEAMNEX_AGE_IDENTITY_FILE=./temp/seamnex-age-identity

# [optional] The `age` binary. Format: executable name or path. Set an absolute path when it is
# installed somewhere the service's PATH does not include.
SEAMNEX_AGE_BINARY=age

# [optional] How many restores run at once. Format: integer 4–12 — the design's floor and ceiling
# (4C.4). Lowering it below the floor is refused, because a serial restore outlives the window.
SEAMNEX_RESTORE_CONCURRENCY=4


# -----------------------------------------------------------------------------
# 11. Workflows (n8n)
# -----------------------------------------------------------------------------

# [optional] n8n REST API base URL. Format: absolute URL, no trailing slash.
SEAMNEX_N8N_URL=http://localhost:5678

# [optional] API key used to activate and inspect workflows. Format: string, or empty. An empty key
# makes activation refuse with a 503 that names n8n, instead of failing later inside a workflow.
SEAMNEX_N8N_API_KEY=

# [optional] How often a running execution is polled. Format: milliseconds, 1000–300000. This is the
# latency a workflow step reports, so it is a trade against API load, not a correctness setting.
SEAMNEX_N8N_EXECUTION_POLL_MS=10000

# [optional] How long a product's field list is trusted before the mapper reads it again. Format:
# milliseconds, 60000–2592000000. A product's schema moves at upgrade time, not during a session;
# a shorter window means more product calls, never more accurate mappings in between.
SEAMNEX_FIELD_DISCOVERY_TTL_MS=86400000

# [optional] Days the item a node produced is kept for the mapper's sample picker. Format: days,
# 1–365. The sample is authoring data, not run history: once expired it is nulled in place and the
# run row keeps its outcome. Shorter is safer; longer is only more convenient.
SEAMNEX_WORKFLOW_SAMPLE_RETENTION_DAYS=30


# -----------------------------------------------------------------------------
# 12. Observability, jobs and retention
# -----------------------------------------------------------------------------

# [optional] Expose Prometheus metrics on `/api/v1/metrics`. Format: 1/0. Disabling it makes the
# scrape target answer 404 ("Metrics are disabled in this deployment"), so keep it on wherever
# Grafana or Alloy is running.
SEAMNEX_METRICS_ENABLED=1

# [optional] Status sampler cadence, fan-out and per-probe timeout (4B.1). Format: milliseconds
# 5000–3600000 (interval), integer 1–64 (concurrency), milliseconds 250–30000 (timeout). The timeout
# is per product: a slow product must not consume the whole cycle.
SEAMNEX_SAMPLE_INTERVAL_MS=30000
SEAMNEX_SAMPLE_CONCURRENCY=16
SEAMNEX_SAMPLE_TIMEOUT_MS=2000

# [optional] How often the sampler persists a `capacity_snapshot` row. Format: milliseconds,
# 10000–3600000. Slower than the status probe on purpose: history is written, status is read.
SEAMNEX_CAPACITY_SAMPLE_INTERVAL_MS=60000

# [optional] Mailpit's HTTP send API, used for alert mail (4B.3). Format: absolute URL. This is the
# *host* address; the compose stack overrides it with `http://mailpit:8025`, because inside a
# container `localhost:8025` is the API itself and every send would fail against a closed port.
SEAMNEX_MAILPIT_URL=http://localhost:8025

# [optional] Envelope sender for that mail. Format: an email address. A production host points
# `SEAMNEX_MAILPIT_URL` at its own MTA and this at a domain it may send from.
SEAMNEX_NOTIFY_FROM=platform@seamnex.local

# [optional] De-duplication window for one instance's health alert. Format: minutes, 1–1440. Without
# a window, a product that flaps mails on every probe cycle.
SEAMNEX_NOTIFY_DEDUPE_MINUTES=30

# [optional] Forward-auth decision cache lifetime. Format: seconds, 1–600. Must stay well under the
# session idle timeout; a long window is a revocation that has not happened yet.
SEAMNEX_FORWARD_AUTH_CACHE_SECONDS=60

# [optional] One-time break-glass credential reveal window (4F.1). Format: seconds, 10–600. It only
# has to survive the click, so seconds — not minutes — is what keeps a leaked URL worthless.
SEAMNEX_REVEAL_TTL_SECONDS=60

# [optional] How many job-log streams one API replica serves at once. Format: integer 1–10000. One
# request beyond it is refused with 429 `STREAM_LIMIT` rather than exhausting the process. Log
# retention is the partition policy below, not this.
SEAMNEX_JOB_STREAM_MAX=100

# [optional] How often the scheduler looks for due work. Format: milliseconds, 1000–3600000.
SEAMNEX_SCHEDULER_INTERVAL_MS=60000

# [optional] Days of `job_log` partitions kept ahead of today. Format: integer 1–180. A missing
# partition fails every append, so this is the recovery window after the scheduler was down.
SEAMNEX_PARTITION_LOOKAHEAD_DAYS=9

# [optional] Retention for `job_log`. Format: days, 1–3650. Expiry is a partition drop, never a
# DELETE: a delete on a partitioned log table is what made the table grow instead of shrinking.
SEAMNEX_JOB_LOG_RETENTION_DAYS=30

# [optional] Build identity, reported by `GET /api/v1/healthz` and in the boot line. Format:
# `<major>.<minor>.<patch>[-<pre>]` for the release tag, and any string for the commit. The API image
# sets both from its build args (`SEAMNEX_BUILD_VERSION`, `GIT_SHA`), so a deployment answers "which
# release is this?" without registry access. `0.0.0` is the workspace placeholder, not a release:
# the version of this project is its git tag (`README.md` §"Versioning and provenance").
SEAMNEX_BUILD_VERSION=0.0.0
SEAMNEX_BUILD_REVISION=unknown

# [optional] [Dev stack] Grafana admin password, used only when the `observability` profile is up.
# Format: string. The dev stack disables anonymous access, so this is the only way in.
GRAFANA_ADMIN_PASSWORD=admin


# -----------------------------------------------------------------------------
# 13. Front end (Vite) — read by the portal and the console, never by the API
# -----------------------------------------------------------------------------

# [optional] Which platform the SPAs talk to. Format: mock | live. `mock` runs the in-browser MSW
# platform (the prototype) and needs no API; `live` talks to the real API through the Vite proxy.
# Two builds ignore it: a production build is always live, and a `--mode demo` build is always mock,
# so neither depends on whichever value a developer's untracked `.env` happens to hold.
VITE_API_MODE=live

# [optional] One value with two jobs. Format: absolute URL, or empty to fall back to
# `http://localhost:8080`. In development it is the Vite proxy target for `/api/v1`, while the SPA
# keeps a relative base so cookies stay same-origin. In a production build the same value is
# compiled into the bundle as the API origin (`api-mode.ts`), so it must be the address a *browser*
# uses, never a container name.
VITE_API_BASE_URL=http://localhost:8080

# [optional] Portal origin, used by the console when it links an operator to the end-user surface,
# and by nothing else. Format: absolute URL, no trailing slash. A console built without it falls
# back to `http://localhost:5173` rather than rendering an empty href.
VITE_PORTAL_URL=http://localhost:5173

# [optional] Hostnames the dev and preview servers answer to. Format: comma-separated names or
# suffixes (a leading dot matches subdomains). `localhost`, its subdomains and every IP address are
# accepted regardless, so this only needs the name a container or a proxy in front of the dev server
# uses. `allowedHosts: true` would accept any `Host` header — the DNS-rebinding hole this closes.
VITE_DEV_ALLOWED_HOSTS=.localhost,.seamnex.local


# -----------------------------------------------------------------------------
# 14. Image build
# -----------------------------------------------------------------------------

# [optional] Alpine package mirror for the `api` image. Format: an origin only — the branch (v3.24)
# is derived from the base image, so no path and no `/alpine`. Empty uses dl-cdn.alpinelinux.org,
# which is what CI does. Where the host's egress filters that CDN the layer stalls in the TLS
# handshake and the build dies with "TLS: unspecified error", then "no such package" for every name.
APK_MIRROR=

# [optional] npm registry for the dependency layer of that image. Format: an origin. Passed as
# `--registry` to that one `pnpm install`, so no mirror is written into the image; empty is the
# public registry and what CI uses.
NPM_REGISTRY=


# =============================================================================
# Production must change
#
# The schema refuses to boot a production process that still carries these development values, so
# none of them can be forgotten — but it is worth knowing before a first deploy:
#
#   NODE_ENV=production                  switches on every guard below
#   AUTH_PROVIDER=oidc                   `stub` is development-only (the browser picks the code)
#   AUTH_ISSUER_URL / AUTH_CLIENT_ID     the real realm; `AUTH_INTERNAL_URL` only if it differs
#   SESSION_COOKIE_SECURE=1              HTTPS-only cookies
#   TRUST_PROXY=<edge address or CIDR>   `1` trusts any client, which defeats the sign-in limit
#   DATABASE_URL / REDIS_URL             real hosts, with DATABASE_POOL_MAX and the budget in step
#   S3_ACCESS_KEY / S3_SECRET_KEY        the published defaults encrypt backups with a public key
#   SEAMNEX_ROOT_KEY_FILE                     a generated key, mode 0600, backed up out of band
#   SEAMNEX_AGE_RECIPIENT                the address archives are encrypted to
#   SEAMNEX_AGE_IDENTITY_FILE            the key that can restore them, escrowed separately
#   SEAMNEX_MAILPIT_URL / NOTIFY_FROM    a real MTA; the default is a local Mailpit that no host runs
#   SEAMNEX_PRODUCT_URL_SCHEME / _PORT        `https` and an empty port (the edge terminates TLS on 443)
#   SEAMNEX_INGRESS_DOMAIN                    the real zone, not `localhost`
#   SEAMNEX_CATALOG_REPO_PATH                 a writable catalogue checkout, not `./temp`
#   VITE_API_MODE / VITE_API_BASE_URL    a production build is always live; set the real API origin
# =============================================================================
