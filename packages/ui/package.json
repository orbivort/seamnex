{
  "name": "@seamnex/ui",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./patterns": {
      "types": "./src/patterns/index.ts",
      "import": "./src/patterns/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "import": "./src/charts/index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "import": "./src/layout/index.ts"
    },
    "./time": {
      "types": "./src/primitives/Time.ts",
      "import": "./src/primitives/Time.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "stylelint": "stylelint --allow-empty-input --cache --cache-location node_modules/.cache/stylelint/.stylelintcache \"src/**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@seamnex/domain": "workspace:*",
    "@seamnex/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@seamnex/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
