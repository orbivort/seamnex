{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "SEAMNEX_ROOT_KEY_FILE"],
  "globalDependencies": [
    "eslint.config.mjs",
    "stylelint.config.mjs",
    "prettier.config.mjs",
    ".prettierignore",
    ".editorconfig",
    "packages/config/**"
  ],
  "tasks": {
    "@seamnex/api#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["VITE_API_BASE_URL", "VITE_PORTAL_URL"],
      "outputs": ["dist/**"]
    },
    "build:demo": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["VITE_API_BASE_URL", "VITE_PORTAL_URL", "VITE_API_MODE"],
      "outputs": ["dist-demo/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "stylelint": {
      "outputs": []
    },
    "test": {
      "env": [
        "SEAMNEX_TEST_DATABASE_URL",
        "AUTH_PROVIDER",
        "APP_ORIGINS",
        "SEAMNEX_REQUIRE_DATABASE_TESTS",
        "SEAMNEX_CATALOG_REPO_PATH",
        "SEAMNEX_ADAPTERS_MODE"
      ],
      "cache": false,
      "outputs": []
    },
    "test:coverage": {
      "env": [
        "SEAMNEX_TEST_DATABASE_URL",
        "AUTH_PROVIDER",
        "APP_ORIGINS",
        "SEAMNEX_REQUIRE_DATABASE_TESTS",
        "SEAMNEX_CATALOG_REPO_PATH",
        "SEAMNEX_ADAPTERS_MODE"
      ],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_API_BASE_URL", "VITE_PORTAL_URL", "VITE_API_MODE"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
